# ============================================================================
# Example environment file. Copy to .env and fill in real values.
#
#     cp .env.example .env
#
# .env is git-ignored and MUST NEVER be committed.
# Every value below is a placeholder. None of them is, or ever was, a real secret.
# ============================================================================

# ---------------------------------------------------------------------------
# Application datasource (chatbot/tool metadata)
# ---------------------------------------------------------------------------
APP_DB_URL=jdbc:mysql://localhost:3306/chatbot_db?useSSL=false&allowPublicKeyRetrieval=true
APP_DB_USERNAME=app_user
APP_DB_PASSWORD=replace-me

# ---------------------------------------------------------------------------
# Vector store (pgvector)
# ---------------------------------------------------------------------------
VECTOR_DB_URL=jdbc:postgresql://localhost:5432/vector_store
VECTOR_DB_USERNAME=app_user
VECTOR_DB_PASSWORD=replace-me

# ---------------------------------------------------------------------------
# Dynamic tool datasource "BS2" (see src/main/resources/static/datasource.properties)
# ---------------------------------------------------------------------------
BS2_DB_URL=jdbc:mysql://localhost:3306/chatbot_db?useSSL=false&allowPublicKeyRetrieval=true
BS2_DB_USERNAME=app_user
BS2_DB_PASSWORD=replace-me

# ---------------------------------------------------------------------------
# Azure OpenAI
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://example.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_DEPLOYMENT=gpt-35-turbo
AZURE_OPENAI_API_VERSION=2024-02-01

# ---------------------------------------------------------------------------
# Azure AI Search (a separate service with its own key - do not reuse the OpenAI key)
# ---------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://example.search.windows.net
AZURE_SEARCH_API_KEY=replace-me
AZURE_SEARCH_INDEX=agent-index

# ---------------------------------------------------------------------------
# Local model runtime (Ollama)
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_GENERATION_MODEL=llama2

# ---------------------------------------------------------------------------
# Document ingestion
# ---------------------------------------------------------------------------
DOCUMENT_UPLOAD_DIR=./uploads

# ---------------------------------------------------------------------------
# API authentication (see SecurityConfig).
# Dev-only in-memory users. Startup fails if these are unset while security is enabled.
# ---------------------------------------------------------------------------
AGENT_USER_PASSWORD=replace-me
AGENT_OPERATOR_PASSWORD=replace-me
AGENT_ADMIN_PASSWORD=replace-me

# ---------------------------------------------------------------------------
# Code execution isolation.
#
# tool-execution.python.sandbox defaults to DOCKER. LOCAL runs tool code on the host
# with NO isolation and is refused at startup unless the flag below is explicitly true.
# Leave this unset unless you know exactly why you are turning isolation off.
# ---------------------------------------------------------------------------
# AGENT_ALLOW_UNSAFE_LOCAL_EXECUTION=false

# ---------------------------------------------------------------------------
# Optional metrics collection (disabled by default)
# ---------------------------------------------------------------------------
METRICS_APPD_URL=
METRICS_APPD_USER=
METRICS_APPD_PASSWORD=
